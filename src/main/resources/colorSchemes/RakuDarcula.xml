<!-- Raku overrides for the Darcula scheme. See RakuDefault.xml for why this
     file is (and should stay) this short. The two must define the same set of
     keys; RakuColorSettingsPageTest checks that, after they drifted apart
     (Darcula neutralized three keys Default did not, Default colored
     RAKU_ROUTINE_NAME and Darcula did not). -->
<list>
  <!-- Pod B<>, I<> and U<> have to actually render bold, italic and
       underlined; that is what the markup means. DOC_COMMENT carries a
       color but no font style. -->
  <option name="RAKU_TEXT_BOLD">
    <value>
      <option name="FONT_TYPE" value="1" />
    </value>
  </option>
  <option name="RAKU_TEXT_ITALIC">
    <value>
      <option name="FONT_TYPE" value="2" />
    </value>
  </option>
  <option name="RAKU_TEXT_UNDERLINE">
    <value>
      <option name="EFFECT_COLOR" value="d0d0d0" />
      <option name="EFFECT_TYPE" value="1" />
    </value>
  </option>

  <!-- Sigspace in a `rule` is whitespace that silently calls <.ws>. Without
       an effect there is nothing to see, since the run is blank. -->
  <option name="RAKU_REGEX_SIG_SPACE">
    <value>
      <option name="EFFECT_COLOR" value="898989" />
      <option name="EFFECT_TYPE" value="5" />
    </value>
  </option>

  <!-- The whole point of ALT_WARNING is to be distinguishable from an
       ordinary weak warning, which its WEAK_WARNING_ATTRIBUTES fallback
       would make it identical to. -->
  <option name="RAKU_ALT_WARNING">
    <value>
      <option name="EFFECT_COLOR" value="56A8F5" />
      <option name="ERROR_STRIPE_COLOR" value="56A8F5" />
      <option name="EFFECT_TYPE" value="2" />
    </value>
  </option>
</list>
